[Unit]
Description=Dashboard Template (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/sdb1/nextcloud/data/mir/files/Dev/Dashboard-Template
ExecStart=/sdb1/nextcloud/data/mir/files/Dev/Dashboard-Template/venv/bin/python dashboard/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
