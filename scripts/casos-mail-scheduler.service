[Unit]
Description=Casos Mail Scheduler
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/sdb1/nextcloud/data/mir/files/Dev/Casos
ExecStart=/sdb1/nextcloud/data/mir/files/Dev/Casos/venv/bin/python scripts/mail_scheduler.py
StandardOutput=journal
StandardError=journal

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ReadWritePaths=/sdb1/nextcloud/data/mir/files/Dev/Casos/data /var/log
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectControlGroups=yes
