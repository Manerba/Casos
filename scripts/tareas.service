[Unit]
Description=Tareas - Aufgabenplanung (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/sdb1/nextcloud/data/mir/files/Dev/Tareas
ExecStart=/sdb1/nextcloud/data/mir/files/Dev/Tareas/venv/bin/python dashboard/app.py
Restart=always
RestartSec=5

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ReadWritePaths=/sdb1/nextcloud/data/mir/files/Dev/Tareas/data /var/log
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
