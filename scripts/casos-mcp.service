[Unit]
Description=Casos MCP - Agentenschnittstelle (Port 8516)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/sdb1/nextcloud/data/mir/files/Dev/Casos
ExecStart=/sdb1/nextcloud/data/mir/files/Dev/Casos/venv/bin/python dashboard/mcp_app.py
Restart=always
RestartSec=5

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ReadWritePaths=/sdb1/nextcloud/data/mir/files/Dev/Casos/data /var/log
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
