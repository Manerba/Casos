[Unit]
Description=Casos LDAP Sync
After=network.target

[Service]
Type=oneshot
User=casos
Group=casos
WorkingDirectory=/opt/casos
ExecStart=/opt/casos/venv/bin/python scripts/ldap_sync_cron.py
StandardOutput=journal
StandardError=journal

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ReadWritePaths=/opt/casos/data /var/log
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectControlGroups=yes
