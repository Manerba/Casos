[Unit]
Description=Casos - Issue-System (FastAPI)
After=network.target

[Service]
Type=simple
User=casos
Group=casos
WorkingDirectory=/opt/casos
ExecStart=/opt/casos/venv/bin/python dashboard/app.py
Restart=always
RestartSec=5

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ReadWritePaths=/opt/casos/data /var/log
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
