#!/bin/bash
set -euo pipefail
case "${1:-}" in configure) ;; *) exit 0 ;; esac
# A prefixed hook may call only explicit local stubs, never host management tools.
PACKAGE_ROOT="${CASOS_PACKAGE_ROOT:-}"
if [ -n "$PACKAGE_ROOT" ]; then
    if [[ "$PACKAGE_ROOT" != /* ]] || [ ! -d "$PACKAGE_ROOT" ]; then
        echo "Invalid isolated package root" >&2; exit 1
    fi
    PACKAGE_ROOT=$(realpath -- "$PACKAGE_ROOT")
    if [ "$PACKAGE_ROOT" = / ]; then echo "Invalid isolated package root" >&2; exit 1; fi
    STUB_DIR="$PACKAGE_ROOT/.casos-hook-stubs"
    if [ -L "$STUB_DIR" ]; then echo "Isolated stubs must be local files" >&2; exit 1; fi
    for command_name in id useradd chown python3 venv-python systemctl; do
        if [ ! -f "$STUB_DIR/$command_name" ] || [ -L "$STUB_DIR/$command_name" ] || [ ! -x "$STUB_DIR/$command_name" ]; then
            echo "Missing isolated hook stub: $command_name" >&2; exit 1
        fi
    done
fi
run_system() {
    local command_name="$1"
    shift
    if [ -n "$PACKAGE_ROOT" ]; then "$STUB_DIR/$command_name" "$@"
    elif [ "$command_name" = venv-python ]; then "$APP_DIR/venv/bin/python" "$@"
    else "$command_name" "$@"
    fi
}
APP_DIR="$PACKAGE_ROOT/opt/casos"
UNIT_DIR="$PACKAGE_ROOT/etc/systemd/system"
SERVICE_USER=casos
if ! run_system id "$SERVICE_USER" >/dev/null 2>&1; then
    run_system useradd --system --user-group --no-create-home --home-dir /opt/casos --shell /usr/sbin/nologin "$SERVICE_USER"
fi
install -d -m 700 "$APP_DIR/data"
if [ ! -x "$APP_DIR/venv/bin/python" ]; then
    run_system python3 -m venv "$APP_DIR/venv"
fi
run_system venv-python -m pip install --quiet -r "$APP_DIR/requirements.txt"
install -d -m 755 "$UNIT_DIR"
for unit in casos.service casos-mcp.service casos-ldap-sync.service casos-ldap-sync.timer casos-mail-scheduler.service casos-mail-scheduler.timer; do
    install -m 644 "$APP_DIR/scripts/$unit" "$UNIT_DIR/$unit"
done
# Runtime is writable by the service; application source stays owned by root.
run_system chown -R "$SERVICE_USER:$SERVICE_USER" "$APP_DIR/data"
run_system systemctl daemon-reload
run_system systemctl enable casos.service casos-mcp.service casos-ldap-sync.timer casos-mail-scheduler.timer
run_system systemctl restart casos.service casos-mcp.service casos-ldap-sync.timer casos-mail-scheduler.timer
echo "Casos installed: web 8514, MCP 8516; settings in the main application."
