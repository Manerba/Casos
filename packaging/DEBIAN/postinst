#!/bin/bash
set -e

APP_DIR="/opt/casos"
DATA_DIR="$APP_DIR/data"
VENV_DIR="$APP_DIR/venv"
SERVICE_USER="casos"

# System-User erstellen (falls nicht vorhanden)
if ! id "$SERVICE_USER" &>/dev/null; then
    useradd --system --no-create-home --home-dir "$APP_DIR" --shell /usr/sbin/nologin "$SERVICE_USER"
    echo "Benutzer '$SERVICE_USER' erstellt."
fi

# Datenverzeichnis erstellen
mkdir -p "$DATA_DIR"

# Python-venv erstellen (falls nicht vorhanden)
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
    echo "Python-venv erstellt."
fi

# Dependencies installieren
"$VENV_DIR/bin/pip" install --quiet --upgrade pip
"$VENV_DIR/bin/pip" install --quiet -r "$APP_DIR/requirements.txt"
echo "Python-Dependencies installiert."

# Service-Dateien kopieren
cp "$APP_DIR/scripts/casos.service" /etc/systemd/system/casos.service
cp "$APP_DIR/scripts/casos-admin.service" /etc/systemd/system/casos-admin.service
cp "$APP_DIR/scripts/casos-mcp.service" /etc/systemd/system/casos-mcp.service
cp "$APP_DIR/scripts/casos-ldap-sync.service" /etc/systemd/system/casos-ldap-sync.service
cp "$APP_DIR/scripts/casos-ldap-sync.timer" /etc/systemd/system/casos-ldap-sync.timer

# Dateiberechtigungen setzen
chown -R "$SERVICE_USER:$SERVICE_USER" "$APP_DIR"

# Systemd neu laden und Services aktivieren
systemctl daemon-reload
systemctl enable casos.service
systemctl enable casos-admin.service
systemctl enable casos-mcp.service
systemctl enable casos-ldap-sync.timer

# Services (neu)starten
systemctl restart casos.service
systemctl restart casos-admin.service
systemctl restart casos-mcp.service
systemctl restart casos-ldap-sync.timer

# Docker-Daemon sicherstellen (wurde als Dependency installiert)
systemctl enable docker.service 2>/dev/null || true
systemctl start docker.service 2>/dev/null || true

# ONLYOFFICE Document Server Setup (Docker)
if [ -x "$APP_DIR/scripts/onlyoffice-setup.sh" ]; then
    echo ""
    echo "--- ONLYOFFICE Setup ---"
    APP_DIR="$APP_DIR" "$APP_DIR/scripts/onlyoffice-setup.sh" || true
fi

echo ""
echo "=== Casos Installation abgeschlossen ==="
echo "  App:   http://$(hostname -I | awk '{print $1}'):8514/"
echo "  Admin: http://$(hostname -I | awk '{print $1}'):8515/"
echo "  MCP:   http://$(hostname -I | awk '{print $1}'):8516/mcp/ (auch weiter auf Port 8514)"
echo ""
