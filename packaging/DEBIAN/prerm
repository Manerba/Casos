#!/bin/bash
set -e

# Services stoppen und deaktivieren
systemctl stop casos.service 2>/dev/null || true
systemctl stop casos-admin.service 2>/dev/null || true
systemctl stop casos-mcp.service 2>/dev/null || true
systemctl stop casos-ldap-sync.timer 2>/dev/null || true
systemctl stop casos-ldap-sync.service 2>/dev/null || true

systemctl disable casos.service 2>/dev/null || true
systemctl disable casos-admin.service 2>/dev/null || true
systemctl disable casos-mcp.service 2>/dev/null || true
systemctl disable casos-ldap-sync.timer 2>/dev/null || true
systemctl disable casos-ldap-sync.service 2>/dev/null || true

echo "Casos Services gestoppt und deaktiviert."
