#!/bin/bash
set -e

APP_DIR="/opt/tareas"
DATA_DIR="$APP_DIR/data"
VENV_DIR="$APP_DIR/venv"
SERVICE_USER="tareas"

# System-User erstellen (falls nicht vorhanden)
if ! id "$SERVICE_USER" &>/dev/null; then
    useradd --system --no-create-home --home-dir "$APP_DIR" --shell /usr/sbin/nologin "$SERVICE_USER"
    echo "Benutzer '$SERVICE_USER' erstellt."
fi

# Datenverzeichnis erstellen
mkdir -p "$DATA_DIR"

# Python-venv erstellen (falls nicht vorhanden)
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
    echo "Python-venv erstellt."
fi

# Dependencies installieren
"$VENV_DIR/bin/pip" install --quiet --upgrade pip
"$VENV_DIR/bin/pip" install --quiet -r "$APP_DIR/requirements.txt"
echo "Python-Dependencies installiert."

# Service-Dateien kopieren
cp "$APP_DIR/scripts/tareas.service" /etc/systemd/system/tareas.service
cp "$APP_DIR/scripts/tareas-admin.service" /etc/systemd/system/tareas-admin.service
cp "$APP_DIR/scripts/tareas-ldap-sync.service" /etc/systemd/system/tareas-ldap-sync.service
cp "$APP_DIR/scripts/tareas-ldap-sync.timer" /etc/systemd/system/tareas-ldap-sync.timer

# Dateiberechtigungen setzen
chown -R "$SERVICE_USER:$SERVICE_USER" "$APP_DIR"

# Systemd neu laden und Services aktivieren
systemctl daemon-reload
systemctl enable tareas.service
systemctl enable tareas-admin.service
systemctl enable tareas-ldap-sync.timer

# Services (neu)starten
systemctl restart tareas.service
systemctl restart tareas-admin.service
systemctl restart tareas-ldap-sync.timer

echo ""
echo "=== Tareas Installation abgeschlossen ==="
echo "  App:   http://$(hostname -I | awk '{print $1}'):8504/"
echo "  Admin: http://$(hostname -I | awk '{print $1}'):8505/"
echo ""
